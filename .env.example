# Merge into .env.local; preserve existing values. Never commit .env.local.
# The API never falls back to in-memory data in postgres mode.
# Use disabled for real Geoapify-only launch with directory/account writes unavailable.
BACKEND_DATA_MODE=postgres
# SERVER ONLY: runtime connection for the restricted our_ground_api role.
# Pooler format: postgresql://our_ground_api.PROJECT_REF:ENCODED_PASSWORD@COPIED_HOST:6543/postgres
DATABASE_URL=
# SERVER / LOCAL TOOL ONLY: migration-owner direct or session-pooler connection.
# Never use this owner connection as DATABASE_URL or put it in a VITE_ variable.
MIGRATION_DATABASE_URL=
# Explicitly identifies the intended DEVELOPMENT project before tools write to it.
SUPABASE_DEV_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional geocoding credential. Without it, ALLOW_DEMO_DATA=true supports only
# the two documented demo cities/ZIP codes; no statewide lookup is claimed.
# Geoapify location proxy is separate from optional mapped-Places discovery.
GEOAPIFY_LOCATION_ENABLED=false
GEOAPIFY_LOCATION_LIVE_APPROVED=false
# All server Geoapify requests share this ceiling (maximum 200, preserving Phase 7C).
GEOAPIFY_SERVER_DAILY_BUDGET=200
GEOAPIFY_SERVER_WARNING_PERCENT=80
GEOAPIFY_LOCATION_DAILY_BUDGET=100
# Default zero automatic retries; optionally one transient-only retry after 500 ms.
GEOAPIFY_LOCATION_MAX_RETRIES=0
# Enable deliberately for fictional seed records, even in a real dev database.
ALLOW_DEMO_DATA=false
API_PORT=8787
# BROWSER PUBLIC values: same Supabase project as the server.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional in-memory demo assignment; requires a real validated Auth session.
DEMO_EDITOR_USER_ID=
# Google OAuth client ID/secret go in Supabase's Google provider settings,
# not this application. No Supabase service-role key is required.
# Optional live-test settings (fresh Supabase sessions; NEVER VITE_):
INTEGRATION_STAFF_ACCESS_TOKEN=
INTEGRATION_OUTSIDER_ACCESS_TOKEN=

# Selected /support stack: Geoapify + MapLibre. Keep the existing Free project.
# Use two DISTINCT keys; enter real values only in ignored .env.local.
GEOAPIFY_SERVER_API_KEY=
VITE_GEOAPIFY_BROWSER_KEY=
# Enable only after the owner checks restrictions and authorizes local live tests.
GEOAPIFY_ENABLED=false
GEOAPIFY_LIVE_APPROVED=false

# Legacy Google adapter retained for rollback; not used by /support.
# Leave disabled during the Geoapify transition. No keys are supplied.
GOOGLE_DISCOVERY_ENABLED=false
GOOGLE_DISCOVERY_LIVE_APPROVED=false
GOOGLE_DISCOVERY_PROJECT_ID=
# SERVER ONLY, separate restricted keys; never copy into VITE_ variables.
GOOGLE_GEOCODING_API_KEY=
GOOGLE_PLACES_API_KEY=
# Public owner-approved HTTPS Terms and Privacy pages, required before enable.
GOOGLE_DISCOVERY_TERMS_URL=
GOOGLE_DISCOVERY_PRIVACY_URL=
# Browser-referrer restricted Maps JavaScript key, distinct from server keys.
VITE_GOOGLE_MAPS_API_KEY=
# Owner's light Google Maps map ID (Advanced Markers require a map ID).
VITE_GOOGLE_MAPS_MAP_ID=

# SERVER ONLY: shared Geoapify admission. Required on Vercel / NODE_ENV=production.
# Same Redis database across all deployments using the same Geoapify project.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Organization email-code authentication. Exact origins only, comma-separated.
# Start with the local preview origin; add production only for an approved release.
ACCOUNT_ALLOWED_ORIGINS=http://127.0.0.1:18418

# Phase 7C: optional Google identity sign-in. Keep disabled until owner configures
# the Supabase Google provider (openid/email/profile) and exact app callback.
VITE_GOOGLE_AUTH_ENABLED=false
VITE_ACCOUNT_ALLOWED_ORIGINS=http://127.0.0.1:18418
# Public operational privacy contact; leave empty until an owner-staffed channel exists.
VITE_PRIVACY_CONTACT_EMAIL=
# ACCOUNT_LOCAL_FIXTURE / LOCAL_FIXTURE_BUILD are test-only and forbidden in production.
# Existing Upstash credentials enforce independent public/API abuse limits; do not
# reset or increase the separate Geoapify 200/day allowance.

# Enable only after Email provider/templates/sender and two real-account tests pass.
ACCOUNT_EMAIL_AUTH_ENABLED=false

# Server-only optional trust root from the owner-selected database SSL settings.
# Remote database TLS always verifies certificates; never disable verification.
DATABASE_SSL_CA=

# Enable only after the reviewed Census reference migration/import in the selected database.
GEOGRAPHIC_REFERENCE_ENABLED=false

# EDEN-03: server-only, disabled by default. Public Gemini is denied in code.
# Private synthetic use only after operator verifies current terms, region and
# an unbilled free-tier project. Never use VITE_ for these values.
GEMINI_API_KEY=
EDEN_GEMINI_MODE=disabled
EDEN_GEMINI_FREE_TIER_CONFIRMED=false
EDEN_GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
EDEN_GEMINI_TTS_ENABLED=false
EDEN_GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
EDEN_DEVELOPMENT_ORIGINS=http://127.0.0.1:5199,http://localhost:5199

# Optional supervised local reviewer grant, issued only after adult/US review.
# Generated server-only by npm run eden:reviewer; never put codes in VITE_ values.
EDEN_REVIEWER_CODE_SHA256=
EDEN_REVIEWER_EXPIRES_AT=
EDEN_REVIEWER_ADULT_VERIFIED=false
EDEN_REVIEWER_COUNTRY=

# Local owner/Live: server-only, actual loopback transport + current adult US grant required.
# Never enable for hosted/public audiences; the permanent key remains server-side.
EDEN_LOCAL_OWNER_ENABLED=false
EDEN_GEMINI_LIVE_ENABLED=false
EDEN_GEMINI_LIVE_MODEL=gemini-3.8-live
EDEN_GEMINI_LIVE_MODEL_CONFIRMED=false

# Server-only, supervised loopback use with the reviewed existing PostgreSQL directory and Census reference.
# Absent on staging/production; never grants Gemini access by itself.
EDEN_LOCAL_DIRECTORY_ENABLED=false
