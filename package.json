{
  "name": "commonground-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/check-node.mjs && vite",
    "dev:api": "node scripts/check-node.mjs && node --env-file-if-exists=.env.local --experimental-strip-types backend/dev.ts",
    "dev:api:demo": "node scripts/check-node.mjs && node --env-file-if-exists=.env.local --experimental-strip-types backend/dev.ts --demo",
    "dev:local:api": "node scripts/local.mjs api-demo",
    "dev:local:web": "node scripts/local.mjs web",
    "preview:local": "node scripts/local.mjs preview",
    "check:local": "node scripts/local.mjs check",
    "check:preview": "node scripts/local.mjs check-preview",
    "build": "node scripts/check-node.mjs && npm run check:secrets && npm run check:env && npm run typecheck && npm run typecheck:backend && vite build",
    "check:env": "node backend/check-env.mjs --public-only",
    "check:setup": "node backend/check-env.mjs",
    "db:status": "node --env-file-if-exists=.env.local backend/manage-db.mjs status",
    "db:migrate": "node --env-file-if-exists=.env.local backend/manage-db.mjs migrate",
    "db:verify": "node --env-file-if-exists=.env.local backend/manage-db.mjs verify",
    "db:grant-editor": "node --env-file-if-exists=.env.local backend/manage-db.mjs grant-editor",
    "test:integration": "node --env-file-if-exists=.env.local --experimental-strip-types --test tests/live.integration.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "tsc --noEmit -p tsconfig.backend.json",
    "test": "node scripts/check-node.mjs && node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "node scripts/check-node.mjs && vite preview",
    "db:bootstrap-admin": "node --env-file-if-exists=.env.local backend/manage-db.mjs bootstrap-admin",
    "test:organizations": "node scripts/check-node.mjs && node --experimental-strip-types --test tests/organization-database.integration.mjs tests/organization-api.integration.mjs",
    "check:secrets": "node scripts/secret-scan.mjs",
    "check:secrets:staged": "node scripts/secret-scan.mjs --staged",
    "check:secrets:build": "node scripts/secret-scan.mjs --build",
    "test:security:db": "node scripts/check-node.mjs && node --experimental-strip-types --test tests/organization-security.integration.mjs tests/organization-retention.integration.mjs",
    "test:security:redis": "node scripts/check-node.mjs && node --experimental-strip-types --test tests/security-redis.integration.mjs",
    "dev:eden": "node scripts/check-node.mjs && vite --config vite.eden.config.ts --host 127.0.0.1 --port 5198 --strictPort",
    "build:eden": "node scripts/check-node.mjs && npm run typecheck && vite build --config vite.eden.config.ts",
    "test:eden": "node scripts/check-node.mjs && node --experimental-strip-types --test tests/eden-*.test.mjs",
    "eden:artwork": "node scripts/eden/build-artwork.mjs",
    "dev:eden:assistant": "node scripts/check-node.mjs && API_PORT=8789 vite --config vite.eden-assistant.config.ts --host 127.0.0.1 --port 5199 --strictPort",
    "dev:eden:agent": "node scripts/check-node.mjs && API_PORT=8789 vite --config vite.eden-assistant.config.ts --mode eden-review --host 127.0.0.1 --port 5199 --strictPort",
    "build:eden:assistant": "node scripts/check-node.mjs && npm run typecheck && vite build --config vite.eden-assistant.config.ts",
    "dev:eden:api": "node scripts/check-node.mjs && API_PORT=8789 BACKEND_DATA_MODE=disabled node --env-file-if-exists=.env.local --experimental-strip-types backend/dev.ts",
    "dev:showcase": "node scripts/check-node.mjs && API_PORT=8789 vite --host 127.0.0.1 --port 5199 --strictPort",
    "eden:reviewer": "node scripts/check-node.mjs && node scripts/eden/create-review-invite.mjs",
    "dev:eden:review": "node scripts/check-node.mjs && API_PORT=8789 BACKEND_DATA_MODE=demo ALLOW_DEMO_DATA=true node --env-file-if-exists=.env.local --env-file=.env.eden-review.local --experimental-strip-types backend/dev.ts"
  },
  "dependencies": {
    "@google/genai": "3.0.0",
    "@gsap/react": "2.1.2",
    "@rive-app/canvas": "2.49.4",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/edge": "1.3.3",
    "gsap": "3.15.1",
    "maplibre-gl": "6.16.0",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "playwright-core": "1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
