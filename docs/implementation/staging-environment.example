# Local owner/preflight template only. Copy to ignored .env.staging.local after exact target approval.
# Never bulk-import this file to Vercel: MIGRATION_DATABASE_URL and CA/maintenance
# owner settings belong only to private owner tooling, not application runtime.
# Never source .env.local into staging or overwrite the existing local values.
VERCEL_ENV=preview
VERCEL_PROJECT_ID=REPLACE_ME_DEDICATED_STAGING_PROJECT_ID
BACKEND_DATA_MODE=postgres
GEOGRAPHIC_REFERENCE_ENABLED=true
# EDEN grants, development origins, provider keys and local data opt-ins must be absent.
ALLOW_DEMO_DATA=false
ACCOUNT_ALLOWED_ORIGINS=https://REPLACE_ME.invalid
VITE_ACCOUNT_ALLOWED_ORIGINS=https://REPLACE_ME.invalid
SUPABASE_DEV_PROJECT_REF=REPLACE_ME_STAGING_PROJECT_REF
SUPABASE_URL=https://REPLACE_ME.supabase.co
VITE_SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_ME_PUBLIC_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_ME_PUBLIC_KEY
DATABASE_URL=REPLACE_ME_RESTRICTED_STAGING_RUNTIME_URL
MIGRATION_DATABASE_URL=REPLACE_ME_SEPARATE_STAGING_OWNER_URL
# Optional private CA certificate when needed; do not disable TLS verification.
DATABASE_SSL_CA=
UPSTASH_REDIS_REST_URL=https://REPLACE_ME.upstash.io/
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME_STAGING_REDIS_TOKEN
GEOAPIFY_SERVER_API_KEY=REPLACE_ME_SEPARATE_STAGING_SERVER_KEY
VITE_GEOAPIFY_BROWSER_KEY=REPLACE_ME_SEPARATE_RESTRICTED_STAGING_BROWSER_KEY
GEOAPIFY_LOCATION_ENABLED=false
GEOAPIFY_LOCATION_LIVE_APPROVED=false
GEOAPIFY_SERVER_DAILY_BUDGET=200
GEOAPIFY_SERVER_WARNING_PERCENT=80
GEOAPIFY_LOCATION_MAX_RETRIES=0
GEOAPIFY_ENABLED=false
GEOAPIFY_LIVE_APPROVED=false
VITE_GOOGLE_AUTH_ENABLED=false
ACCOUNT_EMAIL_AUTH_ENABLED=false
VITE_PRIVACY_CONTACT_EMAIL=

# Local owner-tool batch settings only; one explicit reviewed batch per command.
PRIVACY_RETENTION_BATCH_SIZE=100
PRIVACY_RETENTION_TOTAL_LIMIT=500
